# Speech engine for Voice Over Paint.
#
# Leave VITE_WHISPER_ENDPOINT empty to use the browser Web Speech API.
# Set it to your deployed Whisper Worker to use Whisper. English is the
# default; set VITE_WHISPER_LANGUAGE to change it (e.g. hi, es).
#
# VITE_WHISPER_ENDPOINT=https://voice-over-paint-whisper.example.workers.dev
# VITE_WHISPER_LANGUAGE=en
